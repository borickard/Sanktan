# Upstash Redis credentials for the /api/save and /api/load short-link endpoints.
# Create a database at https://console.upstash.com/redis and copy the REST URL + token.
# For local dev, copy this file to .env.local and fill in the values.
# On Vercel, set these as Environment Variables on the project (Production, Preview, Development).

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
